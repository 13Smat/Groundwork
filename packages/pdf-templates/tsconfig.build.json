{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
