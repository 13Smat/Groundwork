# Empty placeholders only. Copy to .env for local use.
# Do not put real keys, tokens, or passwords in git. This repo is public.
# Neon, R2, Fly, Render, and Modal are not signed up. Local and CI use Docker.

# API listen address. Empty means 0.0.0.0:3001.
HOST=
PORT=

# Docker Postgres + PostGIS. Leave empty outside production to use the local
# compose defaults. Required when NODE_ENV=production. ADR 0005.
DATABASE_URL=
APP_DATABASE_URL=
APP_DB_PASSWORD=

# S3-compatible storage. Local and CI use MinIO. Same rule as DATABASE_URL.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# TiTiler. Empty outside production uses http://127.0.0.1:8080 and the local
# signing secret. Production must set both, and the secret must not be the local default.
TITILER_URL=
TILE_SIGNING_SECRET=

# Structured logs. Empty uses info.
LOG_LEVEL=

# OpenTelemetry. Empty disables export. No vendor account.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# Mailpit is in docker-compose (SMTP 1025, UI 8025). Empty SMTP_HOST logs the
# message outside production and throws in production. No paid email service.
SMTP_HOST=
SMTP_PORT=

# Better Auth. Generate a secret locally. Never commit one.
# Empty BETTER_AUTH_SECRET outside production uses a local default that
# production refuses. Empty BETTER_AUTH_URL and WEB_ORIGIN mean http://127.0.0.1:5173.
# Empty AUTH_DATABASE_URL outside production uses groundwork_auth and APP_DB_PASSWORD.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
AUTH_DATABASE_URL=
WEB_ORIGIN=

# Google sign-in. Leave both empty to keep it off. Setting only one fails startup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dropbox Sign. Local and CI use FakeEsignProvider. Leave every value empty.
# DROPBOX_SIGN_API_KEY selects DropboxSignProvider. DROPBOX_SIGN_LIVE=1 turns
# off test_mode. DROPBOX_SIGN_CLIENT_ID is unused. ESIGN_WEBHOOK_SECRET signs
# the fake provider's webhooks. Empty outside production uses a local default
# that production refuses.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_LIVE=
ESIGN_WEBHOOK_SECRET=

# Imagery ingest. Leave both empty. A live county GeoTIFF download runs only when
# LIVE_FETCH is exactly 1 and TILE_URL is one HTTPS GeoTIFF that is not a
# Google, Mapbox, OneMap, or ArcGIS host. CI does not set either value.
# IMAGERY_INGEST_PYTHON overrides the .venv-imagery interpreter.
GROUNDWORK_IMAGERY_LIVE_FETCH=
GROUNDWORK_IMAGERY_TILE_URL=
IMAGERY_INGEST_PYTHON=

# AI assist. Empty leaves the route off. Set GROUNDWORK_AI_ASSIST to 1 and
# workspace.features.ai_assist to true. The same two gates cover
# POST /takeoffs/:id/assist and POST /detections/:id/accept and reject.
# CV_SERVICE_URL empty outside production means http://127.0.0.1:8090.
# CV_BACKEND empty means mock. Do not set a Modal key. SAM 2 weights are not downloaded.
GROUNDWORK_AI_ASSIST=
CV_SERVICE_URL=
CV_BACKEND=

# Other external services are faked locally and in CI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEOCODER_API_KEY=
PARCEL_API_KEY=
