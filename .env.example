# Empty placeholders only. Copy to .env for local use.
# Do not put real keys, tokens, or passwords in git. This repo is public.
# Neon, R2, Fly, Render, and Modal are not signed up. Local and CI use Docker.

# API listen address. Empty means 0.0.0.0:3001.
HOST=
PORT=

# Docker Postgres + PostGIS. Leave empty outside production to use the local
# compose defaults. Required when NODE_ENV=production. ADR 0005.
DATABASE_URL=
APP_DATABASE_URL=
APP_DB_PASSWORD=

# S3-compatible storage. Local and CI use MinIO. Same rule as DATABASE_URL.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Structured logs. Empty uses info.
LOG_LEVEL=

# OpenTelemetry. Empty disables export. No vendor account.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# Mailpit is in docker-compose (SMTP 1025, UI 8025). No mailer is wired in this slice.
SMTP_HOST=
SMTP_PORT=

# Better Auth. Generate a secret locally. Never commit one.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Dropbox Sign. Local and CI use the fake SignatureProvider.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=

# Other external services are faked locally and in CI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEOCODER_API_KEY=
PARCEL_API_KEY=
