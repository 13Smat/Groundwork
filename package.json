{
  "name": "groundwork",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34.9 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo run typecheck",
    "build:api-deps": "turbo run build --filter=@groundwork/api^...",
    "test": "pnpm build:api-deps && vitest run",
    "test:rls": "pnpm build:api-deps && vitest run --config vitest.rls.config.ts",
    "test:auth": "pnpm build:api-deps && vitest run --config vitest.auth.config.ts",
    "test:crm": "pnpm build:api-deps && vitest run --config vitest.crm.config.ts",
    "test:takeoff": "pnpm build:api-deps && vitest run --config vitest.takeoff.config.ts",
    "test:estimating": "pnpm build:api-deps && vitest run --config vitest.estimating.config.ts",
    "test:proposals": "pnpm build:api-deps && vitest run --config vitest.proposals.config.ts",
    "test:seed": "pnpm build:api-deps && vitest run --config vitest.seed.config.ts",
    "test:contracts": "pnpm build:api-deps && vitest run --config vitest.contracts.config.ts",
    "openapi:write": "pnpm build:api-deps && pnpm --filter @groundwork/api openapi:write",
    "openapi:check": "pnpm build:api-deps && pnpm --filter @groundwork/api openapi:check",
    "test:assist": "pnpm build:api-deps && vitest run --config vitest.assist.config.ts",
    "test:cv": "sh scripts/test-cv.sh",
    "test:e2e": "pnpm build:api-deps && playwright test",
    "test:imagery": "pnpm build:api-deps && vitest run --config vitest.imagery.config.ts",
    "test:tiles": "python3 -m unittest services/tiles/tests/test_guard.py",
    "test:imagery-ingest": "sh scripts/test-imagery-ingest.sh",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:tiles && pnpm test:imagery-ingest && pnpm build && pnpm openapi:check",
    "db:migrate": "pnpm --filter @groundwork/api db:migrate",
    "db:seed": "pnpm build:api-deps && pnpm --filter @groundwork/api db:seed",
    "db:migrate:down": "pnpm --filter @groundwork/api db:migrate:down",
    "worker": "pnpm --filter @groundwork/api worker",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
