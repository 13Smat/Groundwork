{
  "name": "@groundwork/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "worker": "tsx src/worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate.ts --down",
    "db:seed": "tsx src/seed/cli.ts",
    "openapi:write": "tsx src/openapi/cli.ts write",
    "openapi:check": "tsx src/openapi/cli.ts check",
    "openapi:breaking": "tsx src/openapi/cli.ts breaking"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@fastify/swagger": "^9.9.5",
    "@groundwork/geo": "workspace:*",
    "@groundwork/pdf-templates": "workspace:*",
    "@groundwork/pricing": "workspace:*",
    "@groundwork/shared": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "better-auth": "1.7.28",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.9",
    "nodemailer": "7.0.11",
    "pg": "^8.23.1",
    "pg-boss": "^12.40.0",
    "pino": "^10.4.0",
    "playwright-core": "1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "^8.23.1",
    "pdfjs-dist": "4.10.38",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
